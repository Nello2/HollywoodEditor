<Window x:Class="HollywoodEditor.PortraitSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Select Portrait"
        Height="550" 
        Width="750"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinHeight="450"
        MinWidth="600"
        Background="#FF291010"
        Foreground="White">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#4A4A4A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="0" 
                                Margin="0">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="#FFAD3838" Margin="0,0,0,10">
            <TextBlock x:Name="TitleText" Text="Select Portrait" 
                       FontSize="16" 
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,5"/>
        </Border>

        <!-- Информация о персонаже -->
        <Border Grid.Row="1" BorderThickness="1.5" BorderBrush="#FFAD3838" CornerRadius="5" Margin="0,0,0,10" Padding="10">
            <TextBlock x:Name="CharacterInfoText" FontSize="12" Foreground="#CCCCCC" HorizontalAlignment="Center"/>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="PortraitsGrid">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="PortraitBorder" 
                                Margin="5" 
                                BorderThickness="1" 
                                BorderBrush="#4A4A4A" 
                                CornerRadius="5"
                                Background="#2A2A2A"
                                Cursor="Hand"
                                MouseLeftButtonDown="Portrait_Click">
                            <Grid>
                                <Image Source="{Binding Path}" 
                                       Width="80" 
                                       Height="80" 
                                       Stretch="UniformToFill"
                                       Margin="5"/>
                                <Border x:Name="SelectionBorder" 
                                        BorderThickness="2" 
                                        BorderBrush="Transparent" 
                                        CornerRadius="5"
                                        IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Пагинация -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,5">
            <Button x:Name="PrevButton" Content="◀ Previous" Width="80" Click="PrevPage_Click" IsEnabled="False"/>
            <TextBlock x:Name="PageInfo" Text="Page 1 / 1" VerticalAlignment="Center" Margin="15,0" FontSize="12" Foreground="#CCCCCC"/>
            <Button x:Name="NextButton" Content="Next ▶" Width="80" Click="NextPage_Click" IsEnabled="False"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="ApplyButton" Content="Apply" Width="80" Click="Apply_Click" Background="#4A8C4A"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Click="Cancel_Click" Margin="5,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>