<Window x:Class="HollywoodEditor.PerksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Perks Editor"
        Height="780"
        Width="1240"
        MinHeight="660"
        MinWidth="1040"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#FF2B0F0F"
        Foreground="White">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#FF411616"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#FF321111"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FFB83A3A"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#FF8F2929"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#FFC9B7B7"/>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF3F3F3F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFABADB3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FF3F3F3F"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#FFABADB3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,3"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF4A4A4A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF777777"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{StaticResource AccentBrush}" Margin="0,0,0,10">
            <DockPanel Margin="0,5,0,8">
                <TextBlock x:Name="HeaderText"
                           Text="🔬 Perks Editor"
                           FontSize="18"
                           FontWeight="Bold"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="SummaryText"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource AccentDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="PathText" Grid.Row="0" Grid.Column="0" Foreground="{StaticResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ExpandAllButton" Content="Expand all" Click="ExpandAll_Click"/>
                    <Button x:Name="CollapseAllButton" Content="Collapse all" Click="CollapseAll_Click"/>
                    <Button x:Name="ReloadButton" Content="Restore" Click="Restore_Click"/>
                </StackPanel>

                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Grid.Column="0" TextChanged="Filter_Changed"/>
                    <ComboBox x:Name="DepartmentFilterCombo" Grid.Column="2" SelectionChanged="Filter_Changed"/>
                    <ComboBox x:Name="DomainFilterCombo" Grid.Column="4" SelectionChanged="Filter_Changed"/>
                </Grid>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="MainPanel" Margin="0,2,4,2"/>
        </ScrollViewer>

        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource AccentDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="BulkTitleText" Text="Bulk edit" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" DockPanel.Dock="Left"/>
                <ComboBox x:Name="BulkPropertyCombo" Width="180" DockPanel.Dock="Left" Margin="0,0,10,0"/>
                <TextBox x:Name="BulkValueBox" Width="130" DockPanel.Dock="Left" Margin="0,0,10,0"/>
                <Button x:Name="ApplyToAllButton" Content="Apply to all" Width="120" Click="ApplyToAll_Click" DockPanel.Dock="Left"/>
                <TextBlock x:Name="BulkHintText" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="14,0,0,0" DockPanel.Dock="Left"/>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock x:Name="FooterText" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button x:Name="SaveButton" Content="Save" Width="92" Click="Save_Click"/>
                <Button x:Name="CancelButton" Content="Cancel" Width="92" Click="Cancel_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
