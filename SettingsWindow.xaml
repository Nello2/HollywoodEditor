<Window x:Class="HollywoodEditor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HollywoodEditor"
        mc:Ignorable="d"
        Title="Game Settings Editor" 
        Height="700" 
        Width="850"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#FF291010"
        Foreground="White">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#3F3F3F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFABADB3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#FFAD3838"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="#FFAD3838" Margin="0,0,0,10">
            <Grid Margin="0,5,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="ConfigSelector"
                          Grid.Column="0"
                          Panel.ZIndex="1"
                          Width="155"
                          Height="26"
                          Margin="0,0,10,0"
                          SelectedIndex="0"
                          SelectionChanged="ConfigSelector_SelectionChanged"
                          Background="#3F3F3F"
                          Foreground="Black">
                    <ComboBoxItem Content="GameVariables" IsSelected="True"/>
                    <ComboBoxItem Content="Buildings"/>
                    <ComboBoxItem Content="Perks"/>
                </ComboBox>

                <TextBlock x:Name="HeaderText" Text="⚙️ Game Settings" 
                           Grid.Column="0"
                           Grid.ColumnSpan="3"
                           Panel.ZIndex="0"
                           FontSize="16" 
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,5">
            <StackPanel x:Name="MainPanel" Margin="0,5">
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="RestoreButton" Content="Restore" Width="100" Margin="0,0,10,0" Click="Restore_Click" 
                    Background="#4A4A4A" Foreground="White" Padding="10,5"/>
            <Button x:Name="SaveButton" Content="Save" Width="80" Margin="0,0,10,0" Click="Save_Click" 
                    Background="#4A4A4A" Foreground="White" Padding="10,5"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Click="Cancel_Click" 
                    Background="#4A4A4A" Foreground="White" Padding="10,5"/>
        </StackPanel>
    </Grid>
</Window>
